PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
# One address or a comma separated list, e.g. https://app.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# With NODE_ENV=production the server only starts with a JWT_SECRET of 32+ characters
# and a real CORS_ORIGIN (not *).
# NODE_ENV=production
